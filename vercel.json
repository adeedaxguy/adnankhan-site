{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/cron/blog",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/portfolio",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/lead-automation",
      "schedule": "15 2 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/notes",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/notes/",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/notes/:path*",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/work.html",
      "destination": "/portfolio/",
      "permanent": true
    },
    {
      "source": "/services/shopify-developer-ae.html",
      "destination": "/services/shopify-developer-uae.html",
      "permanent": true
    },
    {
      "source": "/blog/shopify-developer-freelance-rates.html",
      "destination": "/blog/hire-shopify-developer-guide-2026.html",
      "permanent": true
    },
    {
      "source": "/blog/landing-page-design-cost.html",
      "destination": "/blog/landing-page-conversion-rate-optimization.html",
      "permanent": true
    },
    {
      "source": "/blog/pricing-page-design.html",
      "destination": "/blog/conversion-focused-web-design.html",
      "permanent": true
    },
    {
      "source": "/blog/free-seo-audit-report-pdf.html",
      "destination": "/free-audit",
      "permanent": true
    },
    {
      "source": "/blog/free-site-audit-report.html",
      "destination": "/free-audit",
      "permanent": true
    },
    {
      "source": "/blog/site-audit-report-pdf.html",
      "destination": "/free-audit",
      "permanent": true
    },
    {
      "source": "/blog/site-audit-report-sample.html",
      "destination": "/free-audit",
      "permanent": true
    },
    {
      "source": "/blog/website-audit-report-generator-free.html",
      "destination": "/free-audit",
      "permanent": true
    },
    {
      "source": "/blog/website-audit-report-sample-pdf.html",
      "destination": "/free-audit",
      "permanent": true
    },
    {
      "source": "/blog/website-structure-audit-report-pdf.html",
      "destination": "/free-audit",
      "permanent": true
    },
    {
      "source": "/blog/seo-compatibility-checker-free.html",
      "destination": "/tools/seo-aeo-checker.html",
      "permanent": true
    },
    {
      "source": "/blog/seo-compatibility-checker-online-free.html",
      "destination": "/tools/seo-aeo-checker.html",
      "permanent": true
    },
    {
      "source": "/blog/seo-compatibility-checker-online.html",
      "destination": "/tools/seo-aeo-checker.html",
      "permanent": true
    },
    {
      "source": "/blog/website-technical-seo-checker.html",
      "destination": "/tools/seo-aeo-checker.html",
      "permanent": true
    },
    {
      "source": "/blog/small-business-website-cost-2026.html",
      "destination": "/blog/custom-website-vs-template.html",
      "permanent": true
    },
    {
      "source": "/go/:token",
      "destination": "https://go.lofts.studio/go/:token",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "adnank.vercel.app"
        }
      ],
      "destination": "https://lofts.studio/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.lofts.studio"
        }
      ],
      "destination": "https://lofts.studio/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    }
  ],
  "headers": [
    {
      "source": "/assets/styles.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/typography.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/home-critical.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/home.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/experience.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/main.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/widgets.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/work/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/brand/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/apple-touch-icon.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/blog/seo-audit-report-template-for-leads.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/blog/website-audit-report-template-free-download.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/blog/website-structure-audit-report-template-excel.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/blog/website-structure-audit-report-template.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
